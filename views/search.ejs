<%- include('partials/header', { basePath: basePath }) %>

<main class="search-page">
    <h1 class="year-heading"><span aria-hidden="true">⌕</span> Search</h1>
    <label class="sr-only" for="searchInput">Search posts</label>
    <input class="search-input" type="search" id="searchInput" placeholder="Search posts…" autocomplete="off">
    <p id="searchHint" class="search-hint" aria-live="polite">Enter at least two characters.</p>
    <div id="searchResults" class="search-results"></div>
</main>

<script>
    const searchInput = document.getElementById('searchInput');
    const searchResults = document.getElementById('searchResults');
    const searchHint = document.getElementById('searchHint');
    let posts = [];

    fetch('<%= basePath %>/search.json')
        .then(response => {
            if (!response.ok) throw new Error('Search index unavailable');
            return response.json();
        })
        .then(data => { posts = data; })
        .catch(() => { searchHint.textContent = 'Search is unavailable right now.'; });

    function appendHighlight(target, text, query) {
        const lowerText = text.toLowerCase();
        const lowerQuery = query.toLowerCase();
        let cursor = 0;
        let match = lowerText.indexOf(lowerQuery);
        while (match !== -1) {
            target.append(document.createTextNode(text.slice(cursor, match)));
            const mark = document.createElement('mark');
            mark.textContent = text.slice(match, match + query.length);
            target.append(mark);
            cursor = match + query.length;
            match = lowerText.indexOf(lowerQuery, cursor);
        }
        target.append(document.createTextNode(text.slice(cursor)));
    }

    searchInput.addEventListener('input', () => {
        const query = searchInput.value.trim();
        searchResults.replaceChildren();
        if (query.length < 2) {
            searchHint.textContent = 'Enter at least two characters.';
            return;
        }

        const lowered = query.toLowerCase();
        const matches = posts.filter(post => post.title.toLowerCase().includes(lowered)
            || post.body.toLowerCase().includes(lowered)
            || (post.tags && post.tags.some(tag => tag.toLowerCase().includes(lowered))));
        searchHint.textContent = `${matches.length} ${matches.length === 1 ? 'result' : 'results'}`;

        if (!matches.length) {
            searchHint.textContent = 'No matching posts.';
            return;
        }

        matches.forEach(post => {
            const row = document.createElement('article');
            row.className = 'post-row';
            const date = document.createElement('time');
            date.className = 'post-date';
            date.dateTime = post.date;
            date.textContent = post.date;
            const title = document.createElement('a');
            title.className = 'post-title';
            title.href = `<%= basePath %>/post/${encodeURIComponent(post.slug)}`;
            appendHighlight(title, post.title, query);
            row.append(date, title);
            searchResults.append(row);
        });
    });
</script>

<%- include('partials/footer') -%>
